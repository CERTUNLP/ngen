# This is the environment file for the development environment
# it will override the values from the ngen.base.env file

### General settings

# Public URL for the frontend used to generate links in emails
FRONTEND_PUBLIC_URL=http://localhost:3000

#### Django

DJANGO_SECRET_KEY=Some_secret_k3y
DJANGO_ALLOWED_HOSTS=*
# Naming the frontend here is what allows it to send the refresh cookie: with no
# origin named the api answers everyone but without credentials
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Shared by the sso login, the login attempt counters and the throttling
DJANGO_CACHE_URL=redis://ngen-redis:6379/3
# Creating an account without being logged in, off unless it is asked for
NGEN_ALLOW_SIGNUP=false
DJANGO_DEBUG=True

#### Frontend

# Keep blank to use the same as the frontend
VITE_APP_API_HOST=
VITE_APP_API_PORT=8000
VITE_APP_API_PATH=/api/
VITE_APP_ENV=development


#### Email 

EMAIL_HOST=ngen-mail
EMAIL_PORT=1025
